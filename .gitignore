# Node
node_modules/

# Bridge-side savegame snapshots (created by snapshot_save / save tools)
snapshots/

# Mod backups written by install scripts before overwriting an existing mod
*.bak-*
*.bak
.backup

# Savegame files backed up by snapshot_load before a restore
*.pre-restore

# ── Reverse-engineering artifacts (MUST NOT be distributed) ─────────────
# recon/ holds extracts of the local game installation (game code copyright
# tobspr Games, GPL-3.0). For local research only — never shipped.
recon/

# Belt-and-braces exclusions in case extraction output lands elsewhere
*.asar
app_extract/
bundle.js
bundle.pretty.js

# OS noise
.DS_Store
Thumbs.db

# Claude Code local session state (never ship)
.claude/

docs/gui/logs/
gui/mcp-config.generated.json

# ── 临时验证产物（本地实验装置，不进公开仓）───────────────────────────
# .tmpverify/ 里是 A/B 装置的脚本、原始结果 json、运行日志。
#   · 脚本：很多是**一次性**的排查工具，不进仓库（早期部分已被跟踪，
#     保留历史不动，只阻止新增）。
#   · 结果 json：单个可达 720K，且是**测量原始数据**，复现应该重跑装置
#     而不是提交数据。
#   · 日志：本地时间戳，无长期价值。
# 但 A/B 装置本身有复现价值 —— 有价值的那些已迁到 research/ai-plan/ 并在
# 对应 P*.md 里点名路径。
.tmpverify/

# 一次性的 wire-ops 压测目录（367 个 run 目录，13MB）
.tmpverify/wire-ops-test/

# 写作时误产生的 Windows 设备名文件（`> nul` 的 shell 残留）
nul

# 运行产物：每次 run 的完整快照（observations / tx / verify 的原始 JSON）
# —— 这些是**机器相关的大文件**（339 MB / 541 个 run），复现应重跑而不是提交数据。
#
# ★ 但 timeline.log **不在此列** —— 它是「AI 怎么想的」唯一的人类可读记录：
#   每轮的模型原话（`say`）、每个调用的理由（`why`）、净效果判定、被拒原因。
#   用户明确要求「复盘应该做成 log 形式，而不是没了以后日志也没了」。
#
#   ⚠️ 不能用 `runs/**/*` + `!runs/**/timeline.log` —— git 一旦排除了父目录
#   就不会再进去看 `!` 规则。必须**逐层**排除：先忽略目录下的文件，
#   再单独放行 log。
research/ai-plan/runs/*/*.json
research/ai-plan/runs/*/*.jsonl
research/ai-plan/tmp/
dist/

# Bridge runtime logs (written by the background process, never committed)
.bridge-out.log
.bridge-err.log
.bridge.log
.bridge.err.log
.bridge-restarts.log
.bridge-supervisor.log
.bridge.pid
.bridge-supervisor.pid

# 临时 obs dump（抓实时世界状态用，机器相关）
research/ai-plan/.obs*.json

# 临时调试脚本（research/ai-plan/.xxx.mjs）
research/ai-plan/.*.mjs
.gitmsg.tmp

.tmpx/

.tmpbench/

# mod 备份（280KB × N，运行时生成）
.modbak/

# ── 本地实验装置与运行产物（一律不进公开仓）────────────────────────────
# run transcript / 调试脚本 / 原始测量数据：机器相关，复现应重跑装置而非提交数据
.tmp-live/
.tmpx2/

# 工作目录根上的 run 产物（脚本从 cwd 写出的 run 目录）
/runs/

# 一次性页面快照（写作时误存的 HTML）
bing.html
out.html

# 编译夹具的输出区（每次跑都重新生成，交接件不是源文件）
research/ai-plan/harness/out/

# 真机实验的原始世界快照（含真实存档数据、单文件近 600KB）
# 复现应当重跑实验装置，而不是提交测量数据。
research/ai-player/facts/live/

# Release 打包临时目录（git archive 解包验证用）
.relbuild/

# agent 循环的 stdout（每次跑都覆盖，机器相关）
.agent-run*.log
.bridge-run.log

# agent 调研时产生的临时探针文件（一次性，机器相关）
.investigate-*
.tmp-critic-*
.agent-driver.log
.agent-verify.log
.v-*.json
research/ai-plan/runs/*.json

# ── 2026-11-20 按 D:\Projects\docs\PROJECT-RULES.md 整改 ────────────────
# 该次整改把一批**历史已提交**的产物移出了仓库（git rm --cached，文件仍在本地）。
# 下面把这几类固化下来，防止它们再被 `git add` 拖回来。

# ① 调研期间的一次性 RPC 抓取（`.s3.json` ~ `.s8.json` 里是游戏截图的 base64，
#    单个 100-340KB，共约 1.6MB）。规则 §2.1：未清理的真实数据不得进公开仓。
#    复现方式应是重跑装置，而不是提交抓取结果。
research/ai-plan/.*.json

# ② GUI 验证的构建日志。规则 §1.4：根目录/文档目录不放构建产物。
#    ⚠️ 只忽略 `docs/gui/*.log`（本层），`docs/gui/logs/` 已在上面单独忽略。
docs/gui/*.log

# ③ 根目录的 RPC dump（早先 `curl ... > .o.json` 的残留，89KB）
/.o.json

# ④ 后台队列的本地状态目录（空目录也算残留）
.bgqueue/

# ⑤ 调研过程中随手截的游戏画面。只保留**被文档实际引用**的那几张
#    （VISUAL-VS-NUMERIC / SCREENSHOT-REDESIGN 里引用的 5 张）。
#    其余 15 张无人引用，2026-11-20 已 git rm --cached 移出仓库。
#    新截图默认不进仓：真实存档画面属于「未清理的真实数据」，且单张常有数百 KB。
research/ai-plan/shot*.png
research/ai-plan/new-shot*.png
# 被文档引用的这 5 张必须留在仓里（文档里的图片链接指着它们）。
# ⚠️ 显式放行是有代价的：以后想替换它们时 `git add` 不会被拦 —— 那是预期行为，
#    因为它们已经在 index 里，ignore 规则对已跟踪文件本来就不生效。
!research/ai-plan/shot-copper-close.png
!research/ai-plan/shot-copper-miners.png
!research/ai-plan/shot-hidehub.png
!research/ai-plan/shot-rutile-cutter-close.png
!research/ai-plan/shot-withhub.png

# ⑥ 调研目录里的运行时日志（bridge 启动横幅、轮询记录）。
#    research/ 下允许放**分析结论**，不放**运行产物**。
research/**/*.log


# 2026-11-21：6-Agent 并行调查的产物
# `.findings/*.md` 是结论（有长期价值，进仓）；
# `.findings/` 下的原始采样 json 是机器相关的，不进。
.findings/*.json
.findings/*.jsonl
.tmp-v/

# A/B 实验的原始采样（每个 json 是一次 LLM 输出，机器相关）
# 复现应重跑装置，而不是提交数据 —— 与 research/ai-plan/runs/ 同一条纪律
research/ai-plan/experiments/*/
