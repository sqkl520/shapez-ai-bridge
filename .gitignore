# Node
node_modules/

# Bridge-side savegame snapshots (created by snapshot_save / save tools)
snapshots/

# Mod backups written by install scripts before overwriting an existing mod
*.bak-*
*.bak
.backup

# Savegame files backed up by snapshot_load before a restore
*.pre-restore

# ── Reverse-engineering artifacts (MUST NOT be distributed) ─────────────
# recon/ holds extracts of the local game installation (game code copyright
# tobspr Games, GPL-3.0). For local research only — never shipped.
recon/

# Belt-and-braces exclusions in case extraction output lands elsewhere
*.asar
app_extract/
bundle.js
bundle.pretty.js

# OS noise
.DS_Store
Thumbs.db

# Claude Code local session state (never ship)
.claude/

docs/gui/logs/
gui/mcp-config.generated.json

# ── 临时验证产物（本地实验装置，不进公开仓）───────────────────────────
# .tmpverify/ 里是 A/B 装置的脚本、原始结果 json、运行日志。
#   · 脚本：很多是**一次性**的排查工具，不进仓库（早期部分已被跟踪，
#     保留历史不动，只阻止新增）。
#   · 结果 json：单个可达 720K，且是**测量原始数据**，复现应该重跑装置
#     而不是提交数据。
#   · 日志：本地时间戳，无长期价值。
# 但 A/B 装置本身有复现价值 —— 有价值的那些已迁到 research/ai-plan/ 并在
# 对应 P*.md 里点名路径。
.tmpverify/

# 一次性的 wire-ops 压测目录（367 个 run 目录，13MB）
.tmpverify/wire-ops-test/

# 写作时误产生的 Windows 设备名文件（`> nul` 的 shell 残留）
nul

# 运行产物：每次 run 的完整快照（observations / tx / verify 的原始 JSON）
# —— 这些是**机器相关的大文件**（339 MB / 541 个 run），复现应重跑而不是提交数据。
#
# ★ 但 timeline.log **不在此列** —— 它是「AI 怎么想的」唯一的人类可读记录：
#   每轮的模型原话（`say`）、每个调用的理由（`why`）、净效果判定、被拒原因。
#   用户明确要求「复盘应该做成 log 形式，而不是没了以后日志也没了」。
#
#   ⚠️ 不能用 `runs/**/*` + `!runs/**/timeline.log` —— git 一旦排除了父目录
#   就不会再进去看 `!` 规则。必须**逐层**排除：先忽略目录下的文件，
#   再单独放行 log。
research/ai-plan/runs/*/*.json
research/ai-plan/runs/*/*.jsonl
research/ai-plan/tmp/
dist/

# Bridge runtime logs (written by the background process, never committed)
.bridge-out.log
.bridge-err.log
.bridge.log
.bridge.err.log
.bridge-restarts.log
.bridge-supervisor.log
.bridge.pid
.bridge-supervisor.pid

# 临时 obs dump（抓实时世界状态用，机器相关）
research/ai-plan/.obs*.json

# 临时调试脚本（research/ai-plan/.xxx.mjs）
research/ai-plan/.*.mjs
.gitmsg.tmp

.tmpx/

.tmpbench/

# mod 备份（280KB × N，运行时生成）
.modbak/

# ── 本地实验装置与运行产物（一律不进公开仓）────────────────────────────
# run transcript / 调试脚本 / 原始测量数据：机器相关，复现应重跑装置而非提交数据
.tmp-live/
.tmpx2/

# 工作目录根上的 run 产物（脚本从 cwd 写出的 run 目录）
/runs/

# 一次性页面快照（写作时误存的 HTML）
bing.html
out.html

# 编译夹具的输出区（每次跑都重新生成，交接件不是源文件）
research/ai-plan/harness/out/

# 真机实验的原始世界快照（含真实存档数据、单文件近 600KB）
# 复现应当重跑实验装置，而不是提交测量数据。
research/ai-player/facts/live/

# Release 打包临时目录（git archive 解包验证用）
.relbuild/

# agent 循环的 stdout（每次跑都覆盖，机器相关）
.agent-run*.log
.bridge-run.log

# agent 调研时产生的临时探针文件（一次性，机器相关）
.investigate-*
.tmp-critic-*
.agent-driver.log
.agent-verify.log
.v-*.json
research/ai-plan/runs/*.json
